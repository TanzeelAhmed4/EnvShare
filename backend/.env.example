DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
ENVSHARE_ENCRYPTION_KEY=generate-and-set-a-base64-encoded-32-byte-key
ENVSHARE_HISTORY_ENCRYPTION_KEY=generate-and-set-a-separate-base64-encoded-32-byte-key
# SQLite is the default. PostgreSQL selection and credentials are supplied
# through the process environment or secret manager, never committed here.
# ENVSHARE_DB_ENGINE=postgresql
# ENVSHARE_DB_NAME=
# ENVSHARE_DB_USER=
# ENVSHARE_DB_PASSWORD=
# ENVSHARE_DB_HOST=
# ENVSHARE_DB_PORT=5432
# ENVSHARE_DB_SSLMODE=require
# ENVSHARE_DB_CONNECT_TIMEOUT=5
# Production requires HTTPS origins, explicit hosts, a private 50+ character Django key,
# the existing 32-byte encryption key, and DJANGO_ENV=production.
# DJANGO_SECURE_HSTS_SECONDS=86400
# DJANGO_SESSION_COOKIE_AGE=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
