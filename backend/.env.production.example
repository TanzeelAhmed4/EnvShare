# Template only. Supply real values through the deployment secret manager.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=api.example.invalid
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.invalid
ENVSHARE_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_BASE64_32_BYTE_KEY

ENVSHARE_DB_ENGINE=postgresql
ENVSHARE_DB_NAME=REPLACE_WITH_DATABASE_NAME
ENVSHARE_DB_USER=REPLACE_WITH_DATABASE_USER
ENVSHARE_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
ENVSHARE_DB_HOST=REPLACE_WITH_DATABASE_HOST
ENVSHARE_DB_PORT=5432
ENVSHARE_DB_SSLMODE=verify-full
# ENVSHARE_DB_SSLROOTCERT=/path/to/ca-certificate.pem

ENVSHARE_CACHE_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SESSION_COOKIE_AGE=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
ENVSHARE_LOG_LEVEL=INFO
ENVSHARE_EMAIL_ENABLED=false
# If email is enabled, also configure EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER,
# EMAIL_HOST_PASSWORD, EMAIL_USE_TLS or EMAIL_USE_SSL, and DEFAULT_FROM_EMAIL.
